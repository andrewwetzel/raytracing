addpath('/home/andrew/code/raytracing/pharlap_4.7.4/src/C');

fprintf('=== Pharlap City Bank Validation ===\n');

fid = fopen('/home/andrew/code/raytracing/packages/raytrace_core/city_bank_results.csv', 'r');
C = textscan(fid, '%s %s %f %f %f %f %f %f %f %f %d %f', 'Delimiter', ',', 'HeaderLines', 1);
fclose(fid);

tx_names = C{1};
rx_names = C{2};
tx_lats = C{3};
tx_lons = C{4};
rx_lats = C{5};
rx_lons = C{6};
bearings = C{7};
rust_target_ranges = C{8};
elevs = C{9};
freqs = C{10};
rust_hops = C{11};

num_tests = length(tx_names);
fprintf('Found %d valid paths from Rust test bank to verify.\n', num_tests);

out_fid = fopen('/home/andrew/code/raytracing/scripts/pharlap_city_validation.csv', 'w');
fprintf(out_fid, 'tx_name,rx_name,freq_mhz,elev,rust_target_range,pharlap_ground_range,delta_km,hops,returned\n');

tol = [1e-8 0.01 2];
foF2 = 10;
hmF2 = 250;
ymF2 = 100;
irregs_flag = 0;

for tt = 1:num_tests
    tx_name = tx_names{tt};
    rx_name = rx_names{tt};
    tx_lat = tx_lats(tt);
    bearing = bearings(tt);
    rust_target_range = rust_target_ranges(tt);
    elev = elevs(tt);
    freq = freqs(tt);
    nhops = double(rust_hops(tt));

    fprintf('Testing %s -> %s (elev: %.2f, hops: %d)... ', tx_name, rx_name, elev, nhops);
    
    ht_start = 0;
    ht_inc = 1;
    num_ht = 600;
    num_range = 200;
    range_inc = max(20, (rust_target_range + 500) / num_range);
    height_arr = ht_start : ht_inc : ht_start + (num_ht-1)*ht_inc;

    iono_en_grid = zeros(num_ht, num_range);
    iono_en_grid_5 = zeros(num_ht, num_range);
    collision_freq_grid = zeros(num_ht, num_range);
    irreg = zeros(4, num_range);

    for jj = 1:num_ht
      h = height_arr(jj);
      zt = max(min((h - hmF2) / ymF2, 30), -30);
      Ne = foF2^2 * exp(0.5 * (1.0 - zt - exp(-zt))) * 1.24e4;
      for ii = 1:num_range
        iono_en_grid(jj, ii) = Ne;
        iono_en_grid_5(jj, ii) = Ne;
      end
    end

    freqs_arr = [freq];
    
    [ray_data, ray_path_data] = raytrace_2d(tx_lat, 130, elev, bearing, freqs_arr, nhops, tol, irregs_flag, iono_en_grid, iono_en_grid_5, collision_freq_grid, ht_start, ht_inc, range_inc, irreg);

    labels = ray_data(1).ray_label;
    ranges = ray_data(1).ground_range;
    
    returned = (labels(end) == 1);
    
    if returned
        pharlap_gr = ranges(end);
        delta = pharlap_gr - rust_target_range;
        fprintf('OK (Pharlap: %.1f km, Delta: %.1f km)\n', pharlap_gr, delta);
    else
        pharlap_gr = 0.0;
        delta = -1.0;
        fprintf('FAILED (Escaped at %f km)\n', ranges(end));
    end

    fprintf(out_fid, '%s,%s,%.1f,%.4f,%.4f,%.4f,%.4f,%d,%d\n', tx_name, rx_name, freq, elev, rust_target_range, pharlap_gr, delta, nhops, returned);
end

fclose(out_fid);
fprintf('\nAll results written to pharlap_city_validation.csv\n');
